# Copy to .env and fill in. This file is used ONLY by the scripts in ./scripts (provision, deploy, webhook).
# At runtime the Worker reads its configuration from the wrangler config `vars` and from Cloudflare secrets —
# `npm run deploy` uploads the secrets below for you. Placeholders only; never commit real values.

# ── Required ────────────────────────────────────────────────────────────────
# Bot token from @BotFather
BOT_TOKEN=123456789:replace-with-your-token
# Random values; if left empty `npm run secrets` generates them (and writes them back here, mode 600)
TELEGRAM_WEBHOOK_SECRET=
INTERNAL_SIGNING_SECRET=
CONTAINER_API_KEY=
# Your numeric Telegram user id(s), comma separated. Find yours with: node scripts/discover-admin.mjs
ADMIN_USER_IDS=

# ── Cloudflare resources (defaults shown) ───────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=
D1_DATABASE_NAME=tvd-db
R2_BUCKET=tvd-media
QUEUE_NAME=tvd-jobs
# Filled in by `npm run deploy` after the first deployment (https://tvd-worker.<your-subdomain>.workers.dev)
PUBLIC_BASE_URL=

# ── Optional ────────────────────────────────────────────────────────────────
# Proxy used by the scripts to reach api.telegram.org when it is blocked on this machine
TELEGRAM_PROXY=
# Needed for MTProto large files (free profile) and for the experimental local Bot API server (UNVERIFIED on Cloudflare — read docs/large-file-delivery.md first)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
LOCAL_BOT_TOKEN=

# ── Tunables live in apps/worker/wrangler.free.jsonc (or wrangler.jsonc) `vars` (documented in docs/operations.md) ──
#   MAX_OUTPUT_BYTES=1900000000     application ceiling per output file, in BYTES
#   MAX_CONCURRENT_JOBS=3           global concurrent downloads
#   MAX_JOBS_PER_USER=2             concurrent jobs per user
#   DOWNLOAD_TIMEOUT=3600           seconds (also PROCESSING_TIMEOUT, UPLOAD_TIMEOUT)
#   TEMP_DIRECTORY=/work            temporary directory inside the container
#   LOG_LEVEL=info                  debug | info | warn | error
#   TELEGRAM_DELIVERY_MODE=auto     auto | bot_api_cloud | bot_api_local | r2_link

# -- Free profile (default): media engine on your own computer (`npm run engine`) -------------------------------------
# TELEGRAM_API_ID / TELEGRAM_API_HASH above are ALSO what enables MTProto uploads (50 MB - ~2 GB) in the free profile.
# They stay on this computer: the free profile never uploads them to Cloudflare.
# Proxy for the engine's downloads (YouTube etc.) when the source sites are blocked on this network (hostname rules still apply):
UPSTREAM_PROXY=
# Engine tuning (all optional)
#   ENGINE_PORT=18080                 local port (8080 is often taken by other tools)
#   ENGINE_WORK_DIR=                  default: ./engine-work (downloads + the Telegram session file; git-ignored)
#   ENGINE_MAX_CONCURRENT_JOBS=2
#   ENGINE_NAME=local-engine
#   TUNNEL_PROTOCOL=auto              auto | quic | http2 (use http2 if QUIC/UDP is blocked)
#   ENGINE_PUBLIC_URL=                only with `npm run engine -- --no-tunnel`: your own https URL for the engine
#   COOKIES_FILE=                     optional yt-dlp cookies file for YOUR account
#   MTPROTO_ENABLED=true